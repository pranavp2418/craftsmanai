# =============================================================================
# Env files — NEVER commit secrets to git!
# =============================================================================
# This blocks EVERY .env variant: .env, .env.local, .env.production, .env.staging,
# .env.development.local, .env.production.local, etc.
# The single exception is .env.example — that's the template developers copy from.
#
# If you ever need a new .env-style file, add an explicit allow rule below
# (e.g. `!.env.shared`) AFTER reviewing it contains no secrets.
!.env.example
.env*.development
.env*.production
.env*.staging
.env

# =============================================================================
# Vercel
# =============================================================================
.vercel

# =============================================================================
