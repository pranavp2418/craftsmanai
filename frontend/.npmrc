# Auto-install peer dependencies (pnpm 8+ default, but explicit for clarity).
auto-install-peers=true

# Don't fail the install if a peer dep warning exists. Next.js + React 19 still
# show occasional peer-range warnings — these are non-blocking.
strict-peer-dependencies=false

# Keep the lockfile in sync with package.json. CI/CD should use `pnpm install --frozen-lockfile`.
prefer-frozen-lockfile=true

# Use a content-addressable store path inside the project so installs are deterministic
# across machines. Comment this out if you'd rather use the global pnpm store.
# store-dir=./.pnpm-store
