    "@mui/material": "^9.0.1",
    "@reduxjs/toolkit": "^2.11.2",
    "axios": "^1.16.0",
    "country-list-with-dial-code-and-flag": "^5.1.1",
    "framer-motion": "^12.38.0",
    "glightbox": "^3.2.0",
    "lucide-react": "^1.14.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-redux": "^9.2.0",
