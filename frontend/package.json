    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.5",
    "prettier": "^3.3.3",
