# Required application infrastructure
DATABASE_URL=postgresql+psycopg2://craftsman:change-me@127.0.0.1:5432/craftsman
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Application security — generate unique production values
SECRET_KEY=change-me
ENVIRONMENT=development
DEBUG=true

# Browser and realtime origins are JSON arrays because Pydantic parses them.
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
SOCKETIO_CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000/

# Supabase Storage (the production bucket is CraftsmanAI)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=change-me
SUPABASE_STORAGE_BUCKET=CraftsmanAI

# Generative AI providers
OPENAI_API_KEY=
IMAGE_PROVIDER=gemini

# Payments and communications
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_FROM_EMAIL=
ZEPTOMAIL_BOUNCE_ADDRESS=

# Web Push
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
